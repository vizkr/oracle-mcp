# SpiritWave Labs MCP Server — Environment Configuration
# Copy to .env and fill in values.

# HTTP port for the MCP server
PORT=3001

# The SpiritWave Labs PHP API base URL to proxy to.
# Production: https://spiritwavelabs.com
# Local dev: http://localhost:8080 (or wherever your PHP server runs)
SWL_API_BASE=https://spiritwavelabs.com

# ── Phase 2: x402 payment (not yet active) ──────────────────────────────────
# The Base USDC wallet address that receives agent payments.
# SWL_PAY_TO=0x...

# Coinbase CDP API key for the x402 facilitator (JWT-based auth).
# SWL_CDP_API_KEY=

# Price per Council reading in USD (converted to USDC atomic units).
# SWL_PRICE_USD=0.01

# Redis URL for payment nonce idempotency (replay protection).
# SWL_REDIS_URL=redis://localhost:6379
